# Used by Drizzle Kit CLI for generating/applying PostgreSQL migrations.
# Set this to a direct Neon connection string or a local PostgreSQL URL.
DATABASE_URL=postgresql://brightglobe:brightglobe_dev@localhost:5432/brightglobe

# Read-only Devnet payout reconciliation remains disabled unless explicitly enabled.
BG_PAYOUT_RECONCILIATION_ENABLED=false
BG_PAYOUT_ARCHIVE_HISTORY_ENABLED=false
BG_PAYOUT_RECONCILIATION_BATCH_SIZE=10
