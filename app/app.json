{
  "expo": {
    "name": "BrightGlobe",
    "slug": "brightglobe",
    "version": "0.1.0",
    "scheme": "brightglobe",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.financingsoft.brightglobe",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "phantom",
          "solflare"
        ]
      }
    },
    "android": {
      "package": "com.financingsoft.brightglobe"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow BrightGlobe to scan wallet QR codes.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
