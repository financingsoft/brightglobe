{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "globe",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "NODE_ENV": "production"
  },
  "env": {
    "staging": {
      "name": "globe-staging",
      "workers_dev": true,
      "vars": {
        "NODE_ENV": "production",
        "SMS_ENABLED": "false",
        "EMAIL_ENABLED": "true"
      }
    }
  },
  "observability": {
    "enabled": true
  }
}
