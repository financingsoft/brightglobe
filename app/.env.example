# Public API origin. Do not put secrets in EXPO_PUBLIC_ variables.
# This same origin hosts Better Auth at /api/auth and user-center APIs at /api/v1.
EXPO_PUBLIC_API_BASE_URL=https://test.globeapps.com

# Set true only for a local visual-test build with no backend. Never enable in production.
EXPO_PUBLIC_ENABLE_PREVIEW_AUTH=false
