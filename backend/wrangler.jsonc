{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "globe",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "vars": {
    "NODE_ENV": "production",
    "BG_TREASURY_RECONCILIATION_ENABLED": "false",
    "BG_PAYOUT_RECONCILIATION_ENABLED": "false",
    "BG_PAYOUT_ARCHIVE_HISTORY_ENABLED": "false",
    "BG_PAYOUT_RECONCILIATION_BATCH_SIZE": "10"
  },
  "env": {
    "staging": {
      "name": "globe-staging",
      "workers_dev": true,
      "vars": {
        "NODE_ENV": "production",
        "SMS_ENABLED": "false",
        "EMAIL_ENABLED": "true",
        "BETTER_AUTH_URL": "https://api.globeapps.com/staging/api/auth",
        "APP_ORIGINS": "https://test.globeapps.com,https://open-staging.globeapps.com",
        "EMAIL_FROM": "BrightGlobe <noreply@go.globeapps.com>",
        "SOLANA_NETWORK": "devnet",
        "SOLANA_RPC_URL": "https://api.devnet.solana.com",
        "BG_TREASURY_RECONCILIATION_ENABLED": "false",
        "BG_PAYOUT_RECONCILIATION_ENABLED": "false",
        "BG_PAYOUT_ARCHIVE_HISTORY_ENABLED": "false",
        "BG_PAYOUT_RECONCILIATION_BATCH_SIZE": "10"
      },
      "triggers": {
        "crons": [
          "*/5 * * * *"
        ]
      }
    }
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
