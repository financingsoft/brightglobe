{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "brightglobe-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "NODE_ENV": "production"
  },
  "observability": {
    "enabled": true
  }
}
