{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contractVersion": "1.0",
  "status": "planned-route-contract",
  "note": "Normative route inventory for implementation. It is not evidence these routes exist or that runtime cache/SEO behavior is verified. implementationStatus distinguishes scaffolded shells from API-backed production routes.",
  "routes": [
    {
      "id": "home",
      "pattern": "/{locale}",
      "surface": "play-web",
      "access": "public",
      "cache": "public-edge",
      "ttlSeconds": 300,
      "seo": "indexable",
      "locale": "path",
      "cacheKey": [
        "locale",
        "path"
      ],
      "invalidationTags": [
        "site-home",
        "locale"
      ],
      "notes": "Localized public landing page.",
      "implementationStatus": "implemented-shell"
    },
    {
      "id": "category-index",
      "pattern": "/{locale}/categories",
      "surface": "play-web",
      "access": "public",
      "cache": "public-edge",
      "ttlSeconds": 900,
      "seo": "indexable",
      "locale": "path",
      "cacheKey": [
        "locale",
        "path"
      ],
      "invalidationTags": [
        "category-index",
        "locale"
      ],
      "notes": "Published category catalogue only.",
      "implementationStatus": "implemented-shell"
    },
    {
      "id": "category-detail",
      "pattern": "/{locale}/categories/{slug}",
      "surface": "play-web",
      "access": "public",
      "cache": "public-edge",
      "ttlSeconds": 900,
      "seo": "indexable",
      "locale": "path",
      "cacheKey": [
        "locale",
        "path"
      ],
      "invalidationTags": [
        "category:{slug}",
        "locale"
      ],
      "notes": "Published category projection."
    },
    {
      "id": "collection-detail",
      "pattern": "/{locale}/collections/{slug}",
      "surface": "play-web",
      "access": "public",
      "cache": "public-edge",
      "ttlSeconds": 600,
      "seo": "indexable",
      "locale": "path",
      "cacheKey": [
        "locale",
        "path"
      ],
      "invalidationTags": [
        "collection:{slug}",
        "locale"
      ],
      "notes": "Published collection only."
    },
    {
      "id": "app-detail",
      "pattern": "/{locale}/apps/{slug}",
      "surface": "play-web",
      "access": "public",
      "cache": "public-edge",
      "ttlSeconds": 600,
      "seo": "indexable",
      "locale": "path",
      "cacheKey": [
        "locale",
        "path"
      ],
      "invalidationTags": [
        "app:{slug}",
        "developer",
        "category",
        "locale"
      ],
      "notes": "Published app projection only.",
      "implementationStatus": "implemented-shell"
    },
    {
      "id": "app-reviews",
      "pattern": "/{locale}/apps/{slug}/reviews",
      "surface": "play-web",
      "access": "public",
      "cache": "public-edge",
      "ttlSeconds": 120,
      "seo": "conditional",
      "locale": "path",
      "cacheKey": [
        "locale",
        "path",
        "page"
      ],
      "invalidationTags": [
        "app:{slug}:reviews",
        "app:{slug}:rating",
        "locale"
      ],
      "notes": "Index only after review quality/moderation thresholds; bounded pagination.",
      "implementationStatus": "implemented-shell"
    },
    {
      "id": "developer-profile",
      "pattern": "/{locale}/developers/{slug}",
      "surface": "play-web",
      "access": "public",
      "cache": "public-edge",
      "ttlSeconds": 600,
      "seo": "indexable",
      "locale": "path",
      "cacheKey": [
        "locale",
        "path"
      ],
      "invalidationTags": [
        "developer:{slug}",
        "locale"
      ],
      "notes": "Published profile fields only."
    },
    {
      "id": "editorial-article",
      "pattern": "/{locale}/articles/{slug}",
      "surface": "play-web",
      "access": "public",
      "cache": "public-edge",
      "ttlSeconds": 900,
      "seo": "indexable",
      "locale": "path",
      "cacheKey": [
        "locale",
        "path"
      ],
      "invalidationTags": [
        "article:{slug}",
        "locale"
      ],
      "notes": "Published editorial content only."
    },
    {
      "id": "search",
      "pattern": "/{locale}/search",
      "surface": "play-web",
      "access": "public",
      "cache": "public-edge",
      "ttlSeconds": 60,
      "seo": "noindex",
      "locale": "path",
      "cacheKey": [
        "locale",
        "normalized-query",
        "bounded-filters",
        "page"
      ],
      "invalidationTags": [
        "search-index",
        "locale"
      ],
      "notes": "Normalize query and allowlist filters; never index arbitrary query combinations.",
      "implementationStatus": "implemented-shell"
    },
    {
      "id": "account",
      "pattern": "/{locale}/account",
      "surface": "play-web",
      "access": "authenticated",
      "cache": "private-no-store",
      "ttlSeconds": 0,
      "seo": "noindex",
      "locale": "path",
      "cacheKey": [],
      "invalidationTags": [],
      "notes": "User-specific data; shared cache forbidden."
    },
    {
      "id": "library",
      "pattern": "/{locale}/library",
      "surface": "play-web",
      "access": "authenticated",
      "cache": "private-no-store",
      "ttlSeconds": 0,
      "seo": "noindex",
      "locale": "path",
      "cacheKey": [],
      "invalidationTags": [],
      "notes": "Bookmarks, follows and download history are private."
    },
    {
      "id": "developer-console",
      "pattern": "/",
      "surface": "developer-console",
      "access": "authenticated",
      "cache": "private-no-store",
      "ttlSeconds": 0,
      "seo": "noindex",
      "locale": "none",
      "cacheKey": [],
      "invalidationTags": [],
      "notes": "Authenticated developer console dashboard on the dedicated open.globeapps.com surface.",
      "implementationStatus": "implemented-shell"
    },
    {
      "id": "admin-console",
      "pattern": "/admin/**",
      "surface": "admin-console",
      "access": "privileged",
      "cache": "private-no-store",
      "ttlSeconds": 0,
      "seo": "noindex",
      "locale": "none",
      "cacheKey": [],
      "invalidationTags": [],
      "notes": "Privileged operations; never shared cache."
    },
    {
      "id": "app-detail-api",
      "pattern": "/api/v1/play/apps/{slug}",
      "surface": "marketplace-api",
      "access": "public",
      "cache": "public-edge",
      "ttlSeconds": 600,
      "seo": "noindex",
      "locale": "none",
      "cacheKey": [
        "slug",
        "locale"
      ],
      "invalidationTags": [
        "app:{slug}",
        "developer",
        "category",
        "locale"
      ],
      "notes": "Anonymous published-only app detail projection; no user/session variation.",
      "implementationStatus": "implemented"
    },
    {
      "id": "app-reviews-api",
      "pattern": "/api/v1/play/apps/{slug}/reviews",
      "surface": "marketplace-api",
      "access": "public",
      "cache": "public-edge",
      "ttlSeconds": 120,
      "seo": "noindex",
      "locale": "none",
      "cacheKey": [
        "slug",
        "locale",
        "cursor",
        "limit"
      ],
      "invalidationTags": [
        "app:{slug}:reviews",
        "app:{slug}:rating",
        "locale"
      ],
      "notes": "Anonymous published-only review projection with bounded signed cursor pagination.",
      "implementationStatus": "implemented"
    },
    {
      "id": "developer-organization-create-api",
      "pattern": "/api/v1/play/developers",
      "surface": "marketplace-api",
      "access": "authenticated",
      "cache": "private-no-store",
      "ttlSeconds": 0,
      "seo": "noindex",
      "locale": "none",
      "cacheKey": [],
      "invalidationTags": [],
      "notes": "Creates a pending publisher organization and its initial owner; private mutation response.",
      "implementationStatus": "implemented-module"
    },
    {
      "id": "developer-invitation-create-api",
      "pattern": "/api/v1/play/developers/{developerId}/invitations",
      "surface": "marketplace-api",
      "access": "authenticated",
      "cache": "private-no-store",
      "ttlSeconds": 0,
      "seo": "noindex",
      "locale": "none",
      "cacheKey": [],
      "invalidationTags": [],
      "notes": "Creates a tenant-scoped membership invitation and sends it to the normalized target email; role authorization is enforced by the transaction service.",
      "implementationStatus": "implemented-module"
    },
    {
      "id": "developer-owner-transfer-api",
      "pattern": "/api/v1/play/developers/{developerId}/owner-transfer",
      "surface": "marketplace-api",
      "access": "authenticated",
      "cache": "private-no-store",
      "ttlSeconds": 0,
      "seo": "noindex",
      "locale": "none",
      "cacheKey": [],
      "invalidationTags": [],
      "notes": "Current owner initiates a verified-email owner transfer; recipient must explicitly accept.",
      "implementationStatus": "implemented-module"
    },
    {
      "id": "developer-invitation-accept-api",
      "pattern": "/api/v1/play/invitations/accept",
      "surface": "marketplace-api",
      "access": "authenticated",
      "cache": "private-no-store",
      "ttlSeconds": 0,
      "seo": "noindex",
      "locale": "none",
      "cacheKey": [],
      "invalidationTags": [],
      "notes": "Accepts a single-use token in the POST body, never in the URL; requires a verified email session.",
      "implementationStatus": "implemented-module"
    },
    {
      "id": "developer-invitation-revoke-api",
      "pattern": "/api/v1/play/developers/{developerId}/invitations/{invitationId}",
      "surface": "marketplace-api",
      "access": "authenticated",
      "cache": "private-no-store",
      "ttlSeconds": 0,
      "seo": "noindex",
      "locale": "none",
      "cacheKey": [],
      "invalidationTags": [],
      "notes": "Revokes a pending tenant-scoped invitation; owner-transfer revocation is restricted to the initiating owner.",
      "implementationStatus": "implemented-module"
    },
    {
      "id": "developer-organization-create",
      "pattern": "/organizations/new",
      "surface": "developer-console",
      "access": "authenticated",
      "cache": "private-no-store",
      "ttlSeconds": 0,
      "seo": "noindex",
      "locale": "none",
      "cacheKey": [],
      "invalidationTags": [],
      "notes": "Create a publisher organization and its initial Owner.",
      "implementationStatus": "implemented-shell"
    },
    {
      "id": "developer-organization-workspace",
      "pattern": "/organizations/{developerId}",
      "surface": "developer-console",
      "access": "authenticated",
      "cache": "private-no-store",
      "ttlSeconds": 0,
      "seo": "noindex",
      "locale": "none",
      "cacheKey": [],
      "invalidationTags": [],
      "notes": "Tenant-scoped organization workspace, active members and manager-only pending invitations.",
      "implementationStatus": "implemented-shell"
    },
    {
      "id": "developer-invitation-accept",
      "pattern": "/invitations/accept",
      "surface": "developer-console",
      "access": "authenticated",
      "cache": "private-no-store",
      "ttlSeconds": 0,
      "seo": "noindex",
      "locale": "none",
      "cacheKey": [],
      "invalidationTags": [],
      "notes": "Accept a single-use invitation token read from the URL fragment, then remove it from browser history before POST.",
      "implementationStatus": "implemented-shell"
    },
    {
      "id": "developer-app-collection-api",
      "pattern": "/api/v1/play/developers/{developerId}/apps",
      "surface": "marketplace-api",
      "access": "authenticated",
      "cache": "private-no-store",
      "ttlSeconds": 0,
      "seo": "noindex",
      "locale": "none",
      "cacheKey": [],
      "invalidationTags": [],
      "notes": "GET lists tenant-scoped app drafts; POST creates an App/Game draft with independently editable localized listings, platform targets and up to three platform-owned categories.",
      "implementationStatus": "implemented-module"
    },
    {
      "id": "developer-app-detail-api",
      "pattern": "/api/v1/play/developers/{developerId}/apps/{appId}",
      "surface": "marketplace-api",
      "access": "authenticated",
      "cache": "private-no-store",
      "ttlSeconds": 0,
      "seo": "noindex",
      "locale": "none",
      "cacheKey": [],
      "invalidationTags": [],
      "notes": "Returns tenant-scoped app draft metadata and localized revision state.",
      "implementationStatus": "implemented-module"
    },
    {
      "id": "developer-app-localization-update-api",
      "pattern": "/api/v1/play/developers/{developerId}/apps/{appId}/localizations/{locale}",
      "surface": "marketplace-api",
      "access": "authenticated",
      "cache": "private-no-store",
      "ttlSeconds": 0,
      "seo": "noindex",
      "locale": "none",
      "cacheKey": [],
      "invalidationTags": [],
      "notes": "Updates only an editable draft localization; submitted or published revisions cannot be modified.",
      "implementationStatus": "implemented-module"
    },
    {
      "id": "developer-app-category-catalogue-api",
      "pattern": "/api/v1/play/developers/{developerId}/categories",
      "surface": "marketplace-api",
      "access": "authenticated",
      "cache": "private-no-store",
      "ttlSeconds": 0,
      "seo": "noindex",
      "locale": "query",
      "cacheKey": [],
      "invalidationTags": [],
      "notes": "Active Globe-owned category taxonomy localized for the requested locale; developers may select categories but cannot mutate taxonomy.",
      "implementationStatus": "implemented-module"
    }
  ]
}
