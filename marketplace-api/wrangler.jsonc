{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "globe-play",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "DEFAULT_LOCALE": "en",
    "SUPPORTED_LOCALES": "en,zh-CN"
  },
  "env": {
    "staging": {
      "name": "globe-play-staging",
      "workers_dev": true,
      "vars": {
        "DEFAULT_LOCALE": "en",
        "SUPPORTED_LOCALES": "en,zh-CN",
        "ENVIRONMENT": "staging"
      }
    }
  },
  "observability": {
    "enabled": true
  }
}
