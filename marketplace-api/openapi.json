{
  "openapi": "3.1.0",
  "info": {
    "title": "Globe Play Public Read API",
    "version": "1.0.0",
    "description": "Anonymous read-only endpoints backed by sanitized published projections."
  },
  "servers": [
    {
      "url": "https://api.globeapps.com"
    }
  ],
  "paths": {
    "/api/v1/play/apps/{slug}": {
      "get": {
        "operationId": "getPublicAppDetail",
        "summary": "Get a published app detail projection",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,138}[a-z0-9]?$"
            }
          },
          {
            "name": "locale",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "en",
                "zh-CN"
              ],
              "default": "en"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Published app detail",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                }
              },
              "ETag": {
                "schema": {
                  "type": "string"
                }
              },
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppEnvelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/play/apps/{slug}/reviews": {
      "get": {
        "operationId": "getPublicAppReviews",
        "summary": "Get a bounded page of published reviews",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "locale",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "en",
                "zh-CN"
              ],
              "default": "en"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 20
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 1024
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Published review page",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                }
              },
              "ETag": {
                "schema": {
                  "type": "string"
                }
              },
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewEnvelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Meta": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "contentLocale",
          "requestedLocale"
        ],
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "contentLocale": {
            "type": "string"
          },
          "requestedLocale": {
            "type": "string"
          }
        }
      },
      "AppEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data",
          "meta"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/PublicAppDetail"
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        }
      },
      "ReviewEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data",
          "meta"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/PublicReviewPage"
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message",
              "requestId"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": "string"
              }
            }
          }
        }
      },
      "PublicAppDetail": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "slug",
          "name",
          "tagline",
          "description",
          "appType",
          "contentLocale",
          "publisher",
          "categories",
          "media",
          "platforms",
          "latestVersions",
          "privacyPolicyUrl",
          "supportUrl",
          "websiteUrl",
          "publishedAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string",
            "maxLength": 140
          },
          "name": {
            "type": "string",
            "maxLength": 160
          },
          "tagline": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 240
          },
          "description": {
            "type": "string"
          },
          "appType": {
            "type": "string",
            "enum": [
              "app",
              "game"
            ]
          },
          "contentLocale": {
            "type": "string"
          },
          "publisher": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "slug",
              "name",
              "verificationStatus",
              "websiteUrl"
            ],
            "properties": {
              "slug": {
                "type": "string",
                "maxLength": 100
              },
              "name": {
                "type": "string",
                "maxLength": 120
              },
              "verificationStatus": {
                "type": "string",
                "enum": [
                  "verified",
                  "unverified"
                ]
              },
              "websiteUrl": {
                "oneOf": [
                  {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https://"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "slug",
                "name"
              ],
              "properties": {
                "slug": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              }
            }
          },
          "media": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "url",
                "alt",
                "width",
                "height"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "icon",
                    "screenshot",
                    "video",
                    "banner"
                  ]
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://"
                },
                "alt": {
                  "type": "string",
                  "maxLength": 240
                },
                "width": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "height": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                }
              }
            }
          },
          "platforms": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "platform",
                "minimumOsVersion",
                "availabilityStatus"
              ],
              "properties": {
                "platform": {
                  "type": "string"
                },
                "minimumOsVersion": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 64
                },
                "availabilityStatus": {
                  "type": "string",
                  "enum": [
                    "available",
                    "unavailable",
                    "limited"
                  ]
                }
              }
            }
          },
          "latestVersions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "platform",
                "versionName",
                "releasedAt",
                "releaseNotes",
                "distribution"
              ],
              "properties": {
                "platform": {
                  "type": "string"
                },
                "versionName": {
                  "type": "string"
                },
                "releasedAt": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                },
                "releaseNotes": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "distribution": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "type",
                      "label",
                      "url"
                    ],
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "official_store_link",
                          "developer_download"
                        ]
                      },
                      "label": {
                        "type": "string",
                        "maxLength": 80
                      },
                      "url": {
                        "type": "string",
                        "format": "uri",
                        "pattern": "^https://"
                      }
                    }
                  }
                }
              }
            }
          },
          "privacyPolicyUrl": {
            "oneOf": [
              {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              },
              {
                "type": "null"
              }
            ]
          },
          "supportUrl": {
            "oneOf": [
              {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              },
              {
                "type": "null"
              }
            ]
          },
          "websiteUrl": {
            "oneOf": [
              {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              },
              {
                "type": "null"
              }
            ]
          },
          "rating": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "average",
              "count"
            ],
            "properties": {
              "average": {
                "type": "number",
                "minimum": 0,
                "maximum": 5
              },
              "count": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PublicReview": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "body",
          "rating",
          "author",
          "appVersion",
          "createdAt",
          "helpfulCount"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 160
          },
          "body": {
            "type": "string",
            "minLength": 1
          },
          "rating": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 5
          },
          "author": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "displayName",
              "publisherAffiliation"
            ],
            "properties": {
              "displayName": {
                "type": "string",
                "maxLength": 80
              },
              "publisherAffiliation": {
                "type": "string",
                "enum": [
                  "none",
                  "developer",
                  "employee",
                  "other"
                ]
              }
            }
          },
          "appVersion": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 80
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "helpfulCount": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "PublicReviewPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "app",
          "items",
          "pageInfo"
        ],
        "properties": {
          "app": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "slug",
              "name"
            ],
            "properties": {
              "slug": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            }
          },
          "rating": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "average",
              "count"
            ],
            "properties": {
              "average": {
                "type": "number",
                "minimum": 0,
                "maximum": 5
              },
              "count": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicReview"
            }
          },
          "pageInfo": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "nextCursor",
              "hasNextPage"
            ],
            "properties": {
              "nextCursor": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "hasNextPage": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "responses": {
      "Error": {
        "description": "Safe error response",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      }
    }
  }
}
