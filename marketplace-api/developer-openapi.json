    "/api/v1/play/invitations/accept": {
      "post": {
        "operationId": "acceptDeveloperInvitation",
        "summary": "Accept a developer organization invitation",
        "description": "Requires a verified Better Auth email session. The single-use token is sent in the request body rather than a URL to reduce access-log and referrer leakage.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "token"
                ],
                "properties": {
                  "token": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
